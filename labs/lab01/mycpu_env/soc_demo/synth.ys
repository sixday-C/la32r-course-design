read_verilog -I labs/lab01/mycpu_env/myCPU labs/lab01/mycpu_env/myCPU/alu.v labs/lab01/mycpu_env/myCPU/csr_file.v labs/lab01/mycpu_env/myCPU/dcache.v labs/lab01/mycpu_env/myCPU/divider_iter.v labs/lab01/mycpu_env/myCPU/EXE_stage.v labs/lab01/mycpu_env/myCPU/ID_stage.v labs/lab01/mycpu_env/myCPU/icache.v labs/lab01/mycpu_env/myCPU/IF_stage.v labs/lab01/mycpu_env/myCPU/MEM_stage.v labs/lab01/mycpu_env/myCPU/mycpu_core.v labs/lab01/mycpu_env/myCPU/mycpu_top.v labs/lab01/mycpu_env/myCPU/regfile.v labs/lab01/mycpu_env/myCPU/tools.v labs/lab01/mycpu_env/myCPU/WB_stage.v labs/lab01/mycpu_env/soc_demo/rtl/uart_mmio.v labs/lab01/mycpu_env/soc_demo/rtl/perf_monitor.v labs/lab01/mycpu_env/soc_demo/rtl/soc_demo_top.v labs/lab01/mycpu_env/soc_demo/rtl/looongson_remote_top.v
